# Copy this file to .env and fill in real values. Never commit .env.
# See the setup notes at the end of this file for where each value comes from.

# --- Auth.js ---
# Generate with: npx auth secret
AUTH_SECRET=

# --- Database (Postgres) ---
# Any standard Postgres connection string works — Neon, Supabase, Vercel
# Postgres, RDS, or a self-hosted instance. No provider-specific driver used.
DATABASE_URL=postgres://user:password@host:5432/dbname

# --- Cloudflare R2 (S3-compatible object storage) ---
# From the Cloudflare dashboard: R2 > Manage API Tokens.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Public base URL for serving objects (a bucket's r2.dev URL, or a custom
# domain you've attached to the bucket). Required for the /admin/jobs
# gallery media manager — uploaded photos/videos are public content and
# need a real URL. (Careers application resumes are the exception: those
# are stored privately and never use this — see README.)
R2_PUBLIC_URL=
# The gallery admin uploads directly from the browser to R2 via presigned
# URLs (not proxied through the server, since video files can be far
# larger than a server function's request body limit). This requires CORS
# to be enabled on the bucket for PUT/GET from your site's origin(s) —
# see the "Gallery job/media admin" section in README.md.

# --- Resend (email notifications) ---
# From resend.com: API Keys. Used to email samantha@cmbeach.com when
# someone submits a job application on /careers.
RESEND_API_KEY=
# Must be an address on a domain you've verified in Resend — Resend will
# reject sends from an unverified domain.
RESEND_FROM_EMAIL=

# -----------------------------------------------------------------------
# Setup checklist (see chat for full details):
# 1. Create a Postgres database and put its connection string above.
# 2. Create an R2 bucket + API token in Cloudflare and fill in the R2_* vars.
# 3. Generate AUTH_SECRET with `npx auth secret` (or any random 32+ byte value).
# 4. Run `npm run db:migrate` to create the tables.
# 5. Run `npm run create-admin` to create your login (you'll be prompted
#    for name/email/password — nothing is hardcoded in the repo).
# 6. Sign up at resend.com, verify a sending domain, create an API key,
#    and fill in RESEND_API_KEY / RESEND_FROM_EMAIL for the careers
#    application notification emails to work.
# -----------------------------------------------------------------------
