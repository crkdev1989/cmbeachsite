# Copy this file to .env and fill in real values. Never commit .env.
# See the setup notes at the end of this file for where each value comes from.

# --- Auth.js ---
# Generate with: npx auth secret
AUTH_SECRET=

# --- Database (Postgres) ---
# Any standard Postgres connection string works — Neon, Supabase, Vercel
# Postgres, RDS, or a self-hosted instance. No provider-specific driver used.
DATABASE_URL=postgres://user:password@host:5432/dbname

# --- Cloudflare R2 (S3-compatible object storage) ---
# From the Cloudflare dashboard: R2 > Manage API Tokens.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Public base URL for serving objects (a bucket's r2.dev URL, or a custom
# domain you've attached to the bucket). Only needed once the bucket is
# actually serving public files.
R2_PUBLIC_URL=

# -----------------------------------------------------------------------
# Setup checklist (see chat for full details):
# 1. Create a Postgres database and put its connection string above.
# 2. Create an R2 bucket + API token in Cloudflare and fill in the R2_* vars.
# 3. Generate AUTH_SECRET with `npx auth secret` (or any random 32+ byte value).
# 4. Run `npm run db:migrate` to create the tables.
# 5. Run `npm run create-admin` to create your login (you'll be prompted
#    for name/email/password — nothing is hardcoded in the repo).
# -----------------------------------------------------------------------
